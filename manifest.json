{
  "manifest_version": 3,
  "name": "AI Reply for Twitter/X",
  "version": "1.2",
  "description": "Generate AI replies on Twitter/X in multiple languages with image & wallet/ID support",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.twimg.com/*",
    "https://pbs.twimg.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitter.com/*",
        "https://*.x.com/*"
      ],
      "js": ["scripts/content.js"],
      "css": ["styles/content.css"]
    }
  ]
}